# Atria ASI / OpenAI-compatible LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=replace_with_fresh_key
OPENAI_BASE_URL=https://api.atria-asi.ai/v1
LLM_MODEL=Atria-Dawn-Preview

# Optional search provider (recommended for real contact discovery)
BRAVE_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# Local-only n8n public API key (Render deployment uses n8n CLI import)
N8N_API_KEY=
